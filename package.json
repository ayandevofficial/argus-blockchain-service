{
  "name": "argus-blockchain-service",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone blockchain trust service for ARGUS evidence chain of custody.",
  "type": "module",
  "engines": {"node": ">=20"},
  "scripts": {
    "build": "tsc --noEmit",
    "compile": "hardhat compile",
    "node": "hardhat node",
    "deploy": "hardhat run scripts/deploy.ts --network localhost",
    "test:contract": "hardhat test",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "5.2.1",
    "helmet": "^8.1.0",
    "zod": "^4.1.5",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "^24.3.0",
    "hardhat": "3.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
